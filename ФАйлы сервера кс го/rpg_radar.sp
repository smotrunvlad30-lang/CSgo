// МОДУЛЬ: СКРЫТИЕ РАДАРА
// ==============================================================================

// Эту функцию мы будем вызывать каждую секунду для каждого игрока
void Radar_OnTick(int client) {
    // Проверяем, жив ли игрок (мертвым ХУД скрывать не нужно)
    if (IsPlayerAlive(client)) {
        
        // Получаем текущие настройки интерфейса игрока
        int hideHud = GetEntProp(client, Prop_Send, "m_iHideHUD");
        
        // 4096 — это специальный сигнал движку CS:GO: "Скрой радар"
        // Сначала проверяем, скрыт ли радар прямо сейчас. 
        // Если нет — добавляем команду на скрытие.
        if ((hideHud & 4096) == 0) {
            SetEntProp(client, Prop_Send, "m_iHideHUD", hideHud | 4096);
        }
    }
}